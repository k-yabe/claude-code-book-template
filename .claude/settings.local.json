{
  "env": {
    "API_TIMEOUT_MS": "900000",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "mcp__playwright__*",
      "mcp__ide__*",
      "Agent(*)",
      "Skill(done)",
      "Skill(done:*)",
      "Skill(new-spec)",
      "Skill(new-spec:*)",
      "Skill(review)",
      "Skill(review:*)",
      "mcp__Claude_Preview__preview_start",
      "mcp__52e6052e-b936-46f6-bd61-54536f986204__list_teams",
      "mcp__52e6052e-b936-46f6-bd61-54536f986204__list_projects",
      "mcp__52e6052e-b936-46f6-bd61-54536f986204__get_runtime_logs",
      "mcp__52e6052e-b936-46f6-bd61-54536f986204__web_fetch_vercel_url",
      "mcp__52e6052e-b936-46f6-bd61-54536f986204__list_deployments",
      "mcp__52e6052e-b936-46f6-bd61-54536f986204__deploy_to_vercel"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright"
  ],
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  }
}
