<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kyabe.ai-agent-overnight-qa</string>

  <key>ProgramArguments</key>
  <array>
    <string>REPLACE_WITH_NODE</string>
    <string>REPLACE_WITH_REPO/scripts/overnight-qa.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 毎朝2時に実行 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>2</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_REPO</string>

  <key>StandardOutPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/ai-agent-overnight-qa.log</string>

  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_HOME/Library/Logs/ai-agent-overnight-qa-error.log</string>
</dict>
</plist>
