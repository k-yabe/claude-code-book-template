<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kyabe.ai-agent-dispatcher</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/node</string>
        <string>REPLACE_WITH_REPO_PATH/ai-agent-org/scripts/task-dispatcher.js</string>
    </array>

    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>REPLACE_WITH_REPO_PATH/ai-agent-org/scripts/mac-setup/dispatcher.log</string>

    <key>StandardErrorPath</key>
    <string>REPLACE_WITH_REPO_PATH/ai-agent-org/scripts/mac-setup/dispatcher.log</string>

    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
