<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kyabe.ai-agent-standup</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/kunito/Documents/ai-agent-workspace/ai-agent-org/ai-agent-org/scripts/morning-standup.js</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>

  <!-- 毎朝7時に実行 -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>WorkingDirectory</key>
  <string>/Users/kunito/Documents/ai-agent-workspace/ai-agent-org/ai-agent-org</string>

  <key>StandardOutPath</key>
  <string>/Users/kunito/Library/Logs/ai-agent-standup.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/kunito/Library/Logs/ai-agent-standup-error.log</string>
</dict>
</plist>
